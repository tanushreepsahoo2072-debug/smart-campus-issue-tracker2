
{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "role": {
          "type": "string",
          "enum": ["citizen", "authority"],
          "description": "The user's role."
        }
      },
      "required": ["uid", "email", "role"]
    },
    "complaint": {
      "title": "Complaint",
      "description": "Represents a single complaint submitted by a user.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email of the user submitting the complaint."
        },
        "title": {
          "type": "string",
          "description": "The title of the complaint."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the complaint."
        },
        "category": {
          "type": "string",
          "description": "The category of the complaint (e.g., Road Maintenance, Waste Management)."
        },
        "latitude": {
            "type": "number",
            "description": "The latitude of the incident location."
        },
        "longitude": {
            "type": "number",
            "description": "The longitude of the incident location."
        },
        "currentStatus": {
          "type": "string",
          "enum": ["InProgress", "Resolved", "Pending", "Open"],
          "description": "The current status of the complaint."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The server timestamp when the complaint was submitted."
        },
        "assignedTo": {
            "type": "string",
            "description": "The UID of the authority member assigned to this complaint."
        },
        "frequency": {
            "type": "string",
            "description": "How often the issue occurs (e.g., recurring, one-time)."
        },
        "imageUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "An array of URLs for images related to the complaint."
        }
      },
      "required": ["email", "title", "description", "latitude", "longitude", "currentStatus", "createdAt"]
    }
  },
  "auth": {
    "providers": ["anonymous", "google.com"]
  },
  "firestore": {
    "/issues/{issueId}": {
      "schema": {
        "$ref": "#/entities/complaint"
      },
      "description": "Stores all submitted issues/complaints."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "Stores user profile information, including their role."
    }
  }
}
