rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to create complaints if they are signed in
    match /complaints/{complaintId} {
      allow create: if request.auth != null;
      
      // Allow users to read complaints if they are authenticated
      allow read: if request.auth != null;

      // Allow users to add photos to their own complaints
      match /photos/{photoId} {
        allow create: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/complaints/$(complaintId)).data.reportedBy;
      }
    }

    // Protect user roles from being edited by clients
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
