rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to create complaints
    match /complaints/{complaintId} {
      allow create: if true;
      
      // Allow users to read complaints if they are authenticated
      allow read: if request.auth != null;

      // Allow users to add photos to their own complaints
      // or allow any write if the complaint was submitted anonymously
      match /photos/{photoId} {
        allow create: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/complaints/$(complaintId)).data.reportedBy || get(/databases/$(database)/documents/complaints/$(complaintId)).data.reportedBy == 'anonymous';
      }
    }

    // Protect user roles from being edited by clients
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
